.page-shell { padding: 30rpx 28rpx 80rpx; }
.wish-hero { position: relative; overflow: hidden; padding: 40rpx 36rpx; border-radius: 36rpx; color: #fff; background: linear-gradient(135deg, #df8a92, #cf675c); box-shadow: 0 16rpx 32rpx rgba(200, 94, 72, .18); }.wish-emoji { position: absolute; top: 24rpx; right: 30rpx; font-size: 78rpx; }.hero-title { font-size: 44rpx; font-weight: 700; }.hero-copy { margin-top: 14rpx; padding-right: 100rpx; font-size: 25rpx; line-height: 1.5; opacity: .9; }
.wish-paper { margin-top: 28rpx; padding: 28rpx 28rpx 12rpx; border: 2rpx solid transparent; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(100, 65, 45, .06); }.mine-paper { border-color: #f2d6cf; }.partner-paper { border-color: #dbe9df; }.paper-head { display: flex; padding-bottom: 22rpx; align-items: center; justify-content: space-between; border-bottom: 2rpx dashed #f0ded4; color: #70584c; }.paper-head > text { color: #c59584; font-size: 23rpx; }.owner-label { font-size: 31rpx; font-weight: 700; }.status-line { margin-top: 8rpx; color: #a78778; font-size: 22rpx; }.wish-item { display: flex; min-height: 112rpx; align-items: center; border-bottom: 2rpx solid #faf4f0; }.wish-icon { position: relative; display: flex; width: 72rpx; height: 72rpx; overflow: hidden; flex: none; align-items: center; justify-content: center; border-radius: 20rpx; font-size: 38rpx; }.wish-sprite { position: absolute; width: 300%; height: 200%; }.wish-name { width: 158rpx; margin-left: 18rpx; font-size: 29rpx; font-weight: 600; }.wish-note { flex: 1; overflow: hidden; color: #a18c80; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }.wish-quantity { margin-left: 12rpx; color: #d86655; font-size: 25rpx; font-weight: 600; }.paper-footer { padding: 24rpx 0 12rpx; color: #b29b8e; text-align: center; font-size: 23rpx; }
.empty-inside { padding: 54rpx 20rpx 44rpx; color: #967f73; text-align: center; font-size: 25rpx; }.empty-inside > text { display: block; margin-bottom: 14rpx; font-size: 58rpx; }.card-actions { padding: 18rpx 0 12rpx; }.primary, .soft { border-radius: 999rpx; font-size: 28rpx; font-weight: 600; line-height: 84rpx; }.primary { color: #fff; background: #d86655; }.soft { color: #b05d4f; background: #f6dfd7; }.mini-button { width: 230rpx; margin-top: 24rpx; line-height: 72rpx; }.ready-note { padding: 20rpx; color: #6f9a82; text-align: center; font-size: 26rpx; font-weight: 600; }
.sunset { background: #f9d8b4; }.berry { background: #f5c6c8; }.cocoa { background: #dec1a8; }.chili { background: #f3bbb0; }.green { background: #d4e6c1; }.gold { background: #f5dda6; }.ocean { background: #cae3ef; }.tomato { background: #f7c0ad; }
